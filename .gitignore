```gitignore
# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environment
.venv/
venv/
env/

# Environment variables / secrets
.env
.env.*
.env.example

# Flask instance data
instance/

# Uploaded files
uploads/

# Generated RAG index
rag_index/

# IDE / editor
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/

# Build / distribution
build/
dist/
*.egg-info/
```
